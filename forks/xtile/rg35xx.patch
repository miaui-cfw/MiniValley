+		}
+	}
+
+	private bool TryEncode(StaticTile tile, out int code)
+	{
+		code = 0;
+		int index = tile.TileIndex;
+		if (index < 0 || index > IndexMask || tile.TileSheet == null)
+		{
+			return false;
+		}
+		int sheet = m_sheetTable.IndexOf(tile.TileSheet);
+		if (sheet < 0)
+		{
+			if (m_sheetTable.Count >= 1023)
+			{
+				return false;
+			}
+			m_sheetTable.Add(tile.TileSheet);
+			sheet = m_sheetTable.Count - 1;
+		}
