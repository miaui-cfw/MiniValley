diff --git a/Microsoft.Xna.Framework.Graphics/Tex16.cs b/Microsoft.Xna.Framework.Graphics/Tex16.cs
new file mode 100644
index 0000000..d354a44
--- /dev/null
+++ b/Microsoft.Xna.Framework.Graphics/Tex16.cs
@@ -0,0 +1,97 @@
+using System;
+using MonoGame.OpenGL;
+
+namespace Microsoft.Xna.Framework.Graphics;
+
+/// <summary>RG35XX port: 32-bit Color textures are stored on the GPU as 16-bit (ES 2.0 packed types), chosen per
+/// upload from the alpha channel: opaque -> RGB565, on/off alpha -> RGBA5551, partial alpha -> RGBA4444.
+/// Halves texture memory; the game still sees SurfaceFormat.Color (uploads are converted, readbacks come back as RGBA8).
+/// MG_TEX16=0 disables it.</summary>
+internal static class Tex16
+{
+	internal const int None = 0, Rgb565 = 1, Rgba5551 = 2, Rgba4444 = 3;
+
+	internal static readonly bool Enabled = Environment.GetEnvironmentVariable("MG_TEX16") != "0";
+
+	internal static int Count565, Count5551, Count4444;
+
+	/// <summary>Assets kept in RGBA8888 (user decision 2026-11-09: smooth gradients in the dialogue box, letters and
+	/// light halos). Exact names match the asset and its localised variants (Cursors.es-ES, not Cursors2); names ending
+	/// in a backslash are folder prefixes. MG_TEX32 overrides the list (comma separated, empty = none).</summary>
+	private static readonly string[] s_keep32 = (Environment.GetEnvironmentVariable("MG_TEX32")
+		?? "LooseSprites\\Cursors,LooseSprites\\textBox,LooseSprites\\letterBG,LooseSprites\\Lighting\\")
+		.Split(',', StringSplitOptions.RemoveEmptyEntries);
+
+	internal static bool Keep32(string asset)
+	{
+		if (asset == null || s_keep32.Length == 0) return false;
+		string name = asset.Replace('/', '\\');
+		foreach (string entry in s_keep32)
+		{
+			if (entry.EndsWith('\\'))
+			{
+				if (name.StartsWith(entry, StringComparison.OrdinalIgnoreCase)) return true;
+			}
+			else if (name.Equals(entry, StringComparison.OrdinalIgnoreCase)
+				|| (name.Length > entry.Length && name[entry.Length] == '.' && name.StartsWith(entry, StringComparison.OrdinalIgnoreCase) && name.IndexOf('\\', entry.Length) < 0))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	internal static long BytesSaved;
+
+	internal static PixelFormat Format(int mode) => mode == Rgb565 ? PixelFormat.Rgb : PixelFormat.Rgba;
+
+	internal static PixelInternalFormat InternalFormat(int mode) => mode == Rgb565 ? PixelInternalFormat.Rgb : PixelInternalFormat.Rgba;
+
+	internal static PixelType Type(int mode) => mode switch
+	{
+		Rgb565 => PixelType.UnsignedShort565,
+		Rgba5551 => PixelType.UnsignedShort5551,
+		_ => PixelType.UnsignedShort4444,
+	};
+
+	/// <summary>Pick the format for RGBA8 pixels from their alpha values.</summary>
+	internal static unsafe int Choose(byte* rgba, int pixels)
+	{
+		bool opaque = true;
+		for (int i = 0; i < pixels; i++)
+		{
+			byte a = rgba[i * 4 + 3];
+			if (a == 255) continue;
+			opaque = false;
+			if (a != 0) return Rgba4444;
+		}
+		return opaque ? Rgb565 : Rgba5551;
+	}
+
+	/// <summary>Convert RGBA8 pixels to the packed 16-bit layout GL expects (red in the high bits), rounding.</summary>
+	internal static unsafe void Convert(byte* rgba, ushort[] dst, int pixels, int mode)
+	{
+		for (int i = 0; i < pixels; i++)
+		{
+			byte* p = rgba + i * 4;
+			int r = p[0], g = p[1], b = p[2], a = p[3];
+			dst[i] = mode switch
+			{
+				Rgb565 => (ushort)(((r * 31 + 127) / 255) << 11 | ((g * 63 + 127) / 255) << 5 | ((b * 31 + 127) / 255)),
+				Rgba5551 => (ushort)(((r * 31 + 127) / 255) << 11 | ((g * 31 + 127) / 255) << 6 | ((b * 31 + 127) / 255) << 1 | (a >= 128 ? 1 : 0)),
+				_ => (ushort)(((r * 15 + 127) / 255) << 12 | ((g * 15 + 127) / 255) << 8 | ((b * 15 + 127) / 255) << 4 | ((a * 15 + 127) / 255)),
+			};
+		}
+	}
+
+	internal static void Note(int mode, int pixels)
+	{
+		switch (mode)
+		{
+		case Rgb565: Count565++; break;
+		case Rgba5551: Count5551++; break;
+		default: Count4444++; break;
+		}
+		BytesSaved += pixels * 2L;
+	}
+}
