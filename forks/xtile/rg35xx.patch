diff --git a/xTile.ObjectModel/BoundTileProperties.cs b/xTile.ObjectModel/BoundTileProperties.cs
new file mode 100644
index 0000000..d7f4256
--- /dev/null
+++ b/xTile.ObjectModel/BoundTileProperties.cs
@@ -0,0 +1,67 @@
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using xTile.Tiles;
+
+namespace xTile.ObjectModel;
+
+/// <summary>RG35XX port: the properties of a compact (cell-stored) tile. Empty for reading, without allocating a
+/// collection per tile; the first write turns the tile into a stored object with a real collection.</summary>
+internal sealed class BoundTileProperties : IPropertyCollection
+{
+	private static readonly PropertyCollection s_empty = new PropertyCollection();
+
+	private readonly StaticTile m_tile;
+
+	internal BoundTileProperties(StaticTile tile)
+	{
+		m_tile = tile;
+	}
+
+	private IPropertyCollection Real => m_tile.MaterializeProperties();
+
+	public PropertyValue this[string key]
+	{
+		get => throw new KeyNotFoundException(key);
+		set => Real[key] = value;
+	}
+
+	public ICollection<string> Keys => s_empty.Keys;
+
+	public ICollection<PropertyValue> Values => s_empty.Values;
+
+	public int Count => 0;
+
+	public bool IsReadOnly => false;
+
+	public void Add(string key, PropertyValue value) => Real.Add(key, value);
+
+	public void Add(KeyValuePair<string, PropertyValue> item) => Real.Add(item);
+
+	public void Clear() { }
+
+	public bool Contains(KeyValuePair<string, PropertyValue> item) => false;
+
+	public bool ContainsKey(string key) => false;
+
+	public void CopyTo(KeyValuePair<string, PropertyValue>[] array, int arrayIndex) { }
+
+	public IEnumerator<KeyValuePair<string, PropertyValue>> GetEnumerator() => ((IEnumerable<KeyValuePair<string, PropertyValue>>)s_empty).GetEnumerator();
+
+	public bool Remove(string key) => false;
+
+	public bool Remove(KeyValuePair<string, PropertyValue> item) => false;
+
+	public bool TryGetValue(string key, out PropertyValue value)
+	{
+		value = null;
+		return false;
+	}
+
+	IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
+
+	public void CopyFrom(IPropertyCollection propertyCollection)
+	{
+		if (propertyCollection != null && propertyCollection.Count > 0) Real.CopyFrom(propertyCollection);
+	}
+}
