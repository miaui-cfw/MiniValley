+	private static readonly string[] s_pagePrefixes = (Environment.GetEnvironmentVariable("MG_PAGE_PREFIXES")
+		?? "Minigames\\,LooseSprites\\ControllerMaps,LooseSprites\\JunimoNote,LooseSprites\\Billboard,LooseSprites\\letterBG,LooseSprites\\Concessions,LooseSprites\\daybg,LooseSprites\\nightbg")
+		.Split(',', StringSplitOptions.RemoveEmptyEntries);
+
+	internal static bool IsPageableAsset(string assetName)
+	{
+		string name = assetName.Replace('/', '\\');
+		foreach (string prefix in s_pagePrefixes)
+		{
+			if (name.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	internal bool _pageable;
+
+	internal bool _pagedOut;
+
+	internal string _pageRoot;
+
+	internal IServiceProvider _pageServices;
+
+	internal static int s_pagedOutCount, s_pagedInCount;
+
+	internal static long s_pagedOutBytes;
+
+	/// <summary>Free the GPU copy of idle pageable textures (GL thread, from Present).</summary>
+	internal static void PageOutIdle()
+	{
+		lock (s_all)
+		{
+			foreach (var w in s_all)
+			{
+				if (!w.TryGetTarget(out var t) || !t._pageable || t._pagedOut || t.glTexture <= 0 || t.IsDisposed) continue;
+				if (Texture.s_frame - t._lastUsedFrame <= PageIdleFrames) continue;
+				long bytes = (long)t.Width * t.Height * (t._tex16 != 0 ? 2 : t.Format.GetSize());
+				GL.DeleteTextures(1, ref t.glTexture);
+				t.glTexture = -1;
+				t.glLastSamplerState = null;
+				t._pagedOut = true;
+				s_pagedOutCount++;
+				s_pagedOutBytes += bytes;
+			}
+		}
+	}
+
+	/// <summary>Bring a paged-out texture back before it is bound or read (GL thread).</summary>
+	internal void EnsureResident()
+	{
