+	private SoundEffect LoadEntry(int i)
+	{
+		lock (_sounds)
+		{
+			_lastUse[i] = ++s_useClock;
+			if (_sounds[i] != null && !_sounds[i].IsDisposed)
+			{
+				return _sounds[i];
+			}
+			if (_sounds[i] != null)
+			{
+				s_cachedBytes -= _streams[i].FileLength;   // disposed elsewhere (dependency released): reload
+				_sounds[i] = null;
+			}
+			StreamInfo info = _streams[i];
+			byte[] buffer;
+			using (Stream stream = AudioEngine.OpenStream(_waveBankFileName))
+			{
+				stream.Seek(info.FileOffset + _playRegionOffset, SeekOrigin.Begin);
+				buffer = new byte[info.FileLength];
+				int read = 0;
+				while (read < buffer.Length)
+				{
+					int n = stream.Read(buffer, read, buffer.Length - read);
+					if (n <= 0) break;
+					read += n;
+				}
+			}
+			DecodeFormat(info.Format, out var codec, out var channels, out var rate, out var alignment);
+			_sounds[i] = new SoundEffect(codec, buffer, channels, rate, alignment, info.LoopStart, info.LoopLength);
+			s_cachedBytes += info.FileLength;
+			Evict(i);
+			return _sounds[i];
+		}
+	}
+
+	/// <summary>Release least recently used entries that are not playing until the cache fits the budget.</summary>
+	private void Evict(int keep)
+	{
+		while (s_cachedBytes > s_cacheBudget)
+		{
+			int victim = -1;
+			for (int j = 0; j < _sounds.Length; j++)
+			{
+				if (j == keep || _sounds[j] == null || IsPlaying(j)) continue;
+				if (victim < 0 || _lastUse[j] < _lastUse[victim]) victim = j;
+			}
+			if (victim < 0) return;   // everything else is playing: go over budget for now
+			s_cachedBytes -= _streams[victim].FileLength;
+			_sounds[victim].Dispose();
+			_sounds[victim] = null;
+			_handedOut[victim]?.Clear();
+		}
+	}
+
+	private bool IsPlaying(int j)
+	{
+		var list = _handedOut[j];
+		if (list == null) return false;
+		foreach (var instance in list)
+		{
+			if (!instance.IsDisposed && instance._effect == _sounds[j] && instance.State != SoundState.Stopped) return true;
+		}
+		return false;
+	}
+
