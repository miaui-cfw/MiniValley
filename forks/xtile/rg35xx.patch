+	/// <summary>A bound tile changed (TileIndex/BlendMode): re-encode its cell if it is still a compact cell.</summary>
+	internal void WriteBack(StaticTile tile)
+	{
+		int cell = tile.m_boundCell;
+		if (cell < 0 || cell >= m_cells.Length || m_cells[cell] <= 0 || !TryEncode(tile, out int code))
+		{
+			tile.m_boundLayer = null;
+			tile.m_boundCell = -1;
